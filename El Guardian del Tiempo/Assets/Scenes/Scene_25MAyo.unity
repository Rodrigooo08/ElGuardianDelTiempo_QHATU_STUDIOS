  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  dialogueLines:
  - 'Rapido, debemos movernos rapido.

    Esta imprenta no permitira que el pueblo
    caiga'
  - 'Por mi nombre AGUSTIN DONADO!

    Esta imprenta enviara esas esquelas'
  - "Los lideres revolucionarios deben estar presentes!\nDon Juan PAso, Manuel Belgrano
    y Nicolas Rodriguez Pe\xF1a"
