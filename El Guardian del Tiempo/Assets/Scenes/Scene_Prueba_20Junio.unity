  quizPanel: {fileID: 945635459}
  questionText: {fileID: 1811375020}
  counterText: {fileID: 1826356652}
  optionButtons:
  - {fileID: 1547260879}
  - {fileID: 1453994037}
  - {fileID: 1312312631}
  optionTexts:
  - {fileID: 1357180163}
  - {fileID: 1110335369}
  - {fileID: 481517434}
  nextButton: {fileID: 17932662}
  normalColor: {r: 1, g: 1, b: 1, a: 1}
  correctColor: {r: 0.35, g: 0.8, b: 0.45, a: 1}
  wrongColor: {r: 0.85, g: 0.35, b: 0.35, a: 1}
  allowNumberKeys: 1
  nextKey: 13
  inputLockDelay: 0.25
  questions:
  - questionText: "\xBFEn qu\xE9 contexto hist\xF3rico cre\xF3 Manuel Belgrano la
      bandera?"
    options:
    - "Durante un per\xEDodo de paz absoluta sin guerras"
    - En medio de luchas, conflictos y escasez de recursos
    - Tras firmar la independencia definitiva
    correctOptionIndex: 1
  - questionText: "\xBFA orillas de qu\xE9 r\xEDo se asocia hist\xF3ricamente el
      izamiento inicial de la bandera creada por Belgrano?"
    options:
    - El Rio de la Plata
    - El Rio Negro de la Patagonia
    - El Rio Parana
    correctOptionIndex: 2
  - questionText: "\xBFC\xF3mo fueron los \xFAltimos a\xF1os y la muerte de Manuel
      Belgrano?"
    options:
    - "Rodeado de grandes fortunas y cargos pol\xEDticos"
    - "Viviendo exiliado en Espa\xF1a hasta su vejez"
    - Marcados por la enfermedad, la escasez y la soledad
    correctOptionIndex: 2
