  m_Script: {fileID: 11500000, guid: 4a87ab205bfb72f42b14c92c89234532, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  dialogueLines:
  - 'Belgrano: Oh querida Amiga, quiero agradecerte tu hospitalidad, por resguardarme
    en tu casa'
  - 'Belgrano: Ahora necesito de tu ayuda para una mision importante'
  - 'Catalina: Como Puedo Ayudarte? Cual es la mision?'
  - 'Belgrano: Confeccionar la Bandera, Celeste y Blanco que nos representara en
    el campo de batalla'
  - 'Catalina: Esto conlleva mucho riesgo, debere estar oculta para elaborarla, asi
    el triunvirato no se entera'
  - 'Belgrano: Te lo Encargo Catalina Echeverria '
  dialoguePanel: {fileID: 2098948861}
  dialogueText: {fileID: 524654443}
